# Dependências diretas de runtime + dev/test. Compiladas para requirements-dev.lock
# com versões pinadas e hashes (SR-11) via:
#   pip-compile --generate-hashes --strip-extras --allow-unsafe \
#     requirements-dev.in -o requirements-dev.lock
#
# NB: pip-tools (a ferramenta que gera o lock) NÃO entra aqui de propósito — ela
# não faz parte do ambiente de teste. Instale-a em versão explícita somente ao
# regenerar o lock: `pip install pip-tools==7.5.3`.
